buitentemperatuur:
  input_text_dynamisch_buitentemperatuur_sensor: "{{ states('input_text.dynamisch_buitentemperatuur_sensor') }}"
  gekozen_buitentemperatuur_sensor: "{{ buiten_sensor }}"
  gekozen_buitentemperatuur_sensor_state: "{{ states(buiten_sensor) }}"
  openweathermap_temperature: "{{ states('sensor.openweathermap_temperature') }}"
  buienradar_temperature: "{{ states('sensor.buienradar_temperature') }}"
  input_text_dynamisch_weather_entity: "{{ states('input_text.dynamisch_weather_entity') }}"
  gekozen_weather_entity: "{{ weather_entity }}"
  gekozen_weather_entity_state: "{{ states(weather_entity) }}"
  gekozen_weather_entity_temperature_attr: "{{ state_attr(weather_entity, 'temperature') }}"
  strategie_buiten_temp_huidig_c: "{{ state_attr(strategie, 'buiten_temp_huidig_c') }}"
  strategie_buiten_temp_bron: "{{ state_attr(strategie, 'buiten_temp_bron') }}"
  strategie_forecast_bron: "{{ state_attr(strategie, 'forecast_bron') }}"
