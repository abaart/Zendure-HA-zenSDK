{# Zendure thermisch algoritme debugdump #}
{% set strategie = 'sensor.dynamisch_handelsstrategie' %}
{% set slots = state_attr(strategie, 'slots') or [] %}

{# Buitentemperatuur voor debug: input_text -> OpenWeatherMap -> Buienradar #}
{% set buiten_sensor_raw = states('input_text.dynamisch_buitentemperatuur_sensor') | trim %}
{% set buiten_sensor_input_geldig = buiten_sensor_raw not in ['', 'unknown', 'unavailable', 'none'] %}
{% set buiten_sensor_input = buiten_sensor_raw if buiten_sensor_input_geldig else none %}
{% set buiten_sensor_openweathermap = 'sensor.openweathermap_temperature' %}
{% set buiten_sensor_buienradar = 'sensor.buienradar_temperature' %}
{% set buiten_sensor =
  buiten_sensor_input
  if buiten_sensor_input is not none and states(buiten_sensor_input) not in ['unknown', 'unavailable', 'none']
  else buiten_sensor_openweathermap
  if states(buiten_sensor_openweathermap) not in ['unknown', 'unavailable', 'none']
  else buiten_sensor_buienradar
%}

{% set weather_raw = states('input_text.dynamisch_weather_entity') | trim %}
{% set weather_entity = weather_raw if weather_raw not in ['', 'unknown', 'unavailable', 'none'] else 'weather.openweathermap' %}

{% set ns = namespace(max_temp=none, max_index=none) %}
{% for i in range(1, 7) %}
  {% set entity = 'sensor.zendure_2400_ac_batterij_' ~ i ~ '_temperatuur' %}
  {% set value = states(entity) | float(default=none) %}
  {% if value is not none and (ns.max_temp is none or value > ns.max_temp) %}
    {% set ns.max_temp = value %}
    {% set ns.max_index = i %}
  {% endif %}
{% endfor %}

tijdstip_debugdump: "{{ now().isoformat() }}"

live_batterij:
  aantal_batterijen: "{{ states('sensor.zendure_2400_ac_aantal_batterijen') }}"
  batterij_volgorde: "{{ states('input_text.zendure_2400_ac_batterij_volgorde') }}"
  warmste_batterij_sensor: "{{ states('sensor.zendure_2400_ac_warmste_batterij_temperatuur') }}"
  warmste_batterij_index_sensor: "{{ states('sensor.zendure_2400_ac_warmste_batterij_index') }}"
  warmste_batterij_berekend_in_template: "{{ ns.max_temp }}"
  warmste_batterij_index_berekend_in_template: "{{ ns.max_index }}"
  batterij_1_temperatuur: "{{ states('sensor.zendure_2400_ac_batterij_1_temperatuur') }}"
  batterij_2_temperatuur: "{{ states('sensor.zendure_2400_ac_batterij_2_temperatuur') }}"
  batterij_3_temperatuur: "{{ states('sensor.zendure_2400_ac_batterij_3_temperatuur') }}"
  batterij_4_temperatuur: "{{ states('sensor.zendure_2400_ac_batterij_4_temperatuur') }}"
  batterij_5_temperatuur: "{{ states('sensor.zendure_2400_ac_batterij_5_temperatuur') }}"
  batterij_6_temperatuur: "{{ states('sensor.zendure_2400_ac_batterij_6_temperatuur') }}"
  omvormer_temperatuur: "{{ states('sensor.zendure_2400_ac_omvormer_temperatuur') }}"

live_accu_en_vermogen:
  laadpercentage: "{{ states('sensor.zendure_2400_ac_laadpercentage') }}"
  minimale_laadpercentage: "{{ states('sensor.zendure_2400_ac_minimale_laadpercentage') }}"
  maximale_laadpercentage: "{{ states('sensor.zendure_2400_ac_maximale_laadpercentage') }}"
  totale_capaciteit_kwh: "{{ states('sensor.zendure_2400_ac_totale_capaciteit') }}"
  indicatie_beschikbare_energie_kwh: "{{ states('sensor.zendure_2400_ac_indicatie_beschikbare_energie') }}"
  indicatie_benodigde_energie_kwh: "{{ states('sensor.zendure_2400_ac_indicatie_benodigde_energie') }}"
  rte_totaal_pct: "{{ states('sensor.zendure_2400_ac_rte_totaal') }}"
  vermogen_aansturing_w: "{{ states('sensor.zendure_2400_ac_vermogen_aansturing') }}"
  ingesteld_oplaadvermogen_w: "{{ states('sensor.zendure_2400_ac_ingesteld_oplaadvermogen') }}"
  ingesteld_ontlaadvermogen_w: "{{ states('sensor.zendure_2400_ac_ingesteld_ontlaadvermogen') }}"
  max_oplaadvermogen_helper_w: "{{ states('input_number.zendure_2400_ac_max_oplaadvermogen') }}"
  max_ontlaadvermogen_helper_w: "{{ states('input_number.zendure_2400_ac_max_ontlaadvermogen') }}"
