thermische_slots_eerste_48:
{% for slot in slots[:48] %}
  - index: {{ loop.index0 }}
    start: "{{ slot.start if slot.start is defined else slot.get('start') }}"
    actie: "{{ slot.actie if slot.actie is defined else slot.get('actie') }}"
    vermogen_w: "{{ slot.vermogen_w if slot.vermogen_w is defined else slot.get('vermogen_w') }}"
    verwacht_vermogen_w: "{{ slot.verwacht_vermogen_w if slot.verwacht_vermogen_w is defined else slot.get('verwacht_vermogen_w') }}"
    soc_voor_pct: "{{ slot.soc_voor_pct if slot.soc_voor_pct is defined else slot.get('soc_voor_pct') }}"
    soc_na_pct: "{{ slot.soc_na_pct if slot.soc_na_pct is defined else slot.get('soc_na_pct') }}"
    soc_voor_kwh: "{{ slot.soc_voor_kwh if slot.soc_voor_kwh is defined else slot.get('soc_voor_kwh') }}"
    soc_na_kwh: "{{ slot.soc_na_kwh if slot.soc_na_kwh is defined else slot.get('soc_na_kwh') }}"
    actuele_soc_kwh: "{{ slot.actuele_soc_kwh if slot.actuele_soc_kwh is defined else slot.get('actuele_soc_kwh') }}"
    doel_soc_kwh: "{{ slot.doel_soc_kwh if slot.doel_soc_kwh is defined else slot.get('doel_soc_kwh') }}"
    c_waarde: "{{ slot.c_waarde if slot.c_waarde is defined else slot.get('c_waarde') }}"
    batterij_temp_voor_c: "{{ slot.batterij_temp_voor_c if slot.batterij_temp_voor_c is defined else slot.get('batterij_temp_voor_c') }}"
    batterij_temp_na_c: "{{ slot.batterij_temp_na_c if slot.batterij_temp_na_c is defined else slot.get('batterij_temp_na_c') }}"
    buiten_temp_c: "{{ slot.buiten_temp_c if slot.buiten_temp_c is defined else slot.get('buiten_temp_c') }}"
